# From TikTok Shop Partner Center -> App & Service -> your app -> Credentials
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_SERVICE_ID=

# Must EXACTLY match the Redirect URL saved in Partner Center
TTS_REDIRECT_URI=https://nb-tiktok-api.onrender.com/callback

# Protects /connect, /refresh and the data endpoints. Make up a long random string.
ADMIN_TOKEN=

# Where the refresh token is written. On Render set this to your mounted disk.
TOKEN_STORE_PATH=/var/data/tokens.json

# --- keeping the connection alive ---
REFRESH_EVERY_HOURS=6
# Disaster recovery: paste the last known refresh token to restore WITHOUT re-authorising
TOKEN_BOOTSTRAP=
# Optional Slack/Discord webhook, shouts if refreshing starts failing
ALERT_WEBHOOK=
